# tawk.to REST API key (Basic auth). Required by the sync job.
TAWK_API_KEY=your_api_key_here

# Supabase — the central datastore (all reports + escalations read/write here).
# Project URL and the SECRET key (sb_secret_… / service_role). Server-side only;
# never expose the secret key to the browser. If unset, the app falls back to
# live tawk.to reads + a local JSON file store (local dev only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Optional: protect /api/sync and /api/webhooks/register. If set, callers
# (Supabase/Vercel cron, the register call) must send "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=some-long-random-string

# Realtime webhooks (Phase 4):
#  - TAWK_WEBHOOK_SECRET: if set, the /api/tawk-webhook endpoint verifies tawk's
#    signature (enforced once the signature header/format is confirmed from a live hit).
#  - WEBHOOK_URL: override the auto-detected webhook URL used during registration
#    (defaults to <deployed origin>/api/tawk-webhook).
# TAWK_WEBHOOK_SECRET=some-long-random-string
# WEBHOOK_URL=https://your-app.vercel.app/api/tawk-webhook
