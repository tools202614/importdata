# tawk.to REST API key (Basic auth). Required for all reporting tabs.
TAWK_API_KEY=your_api_key_here

# Escalation records storage.
# Leave BOTH unset for local dev → records persist to a local JSON file (web/data/).
# On Vercel, add a Vercel Postgres / Neon store and this is set automatically.
# POSTGRES_URL=postgres://user:pass@host/db
# (DATABASE_URL is also accepted as a fallback, e.g. the Neon integration.)
