# tawk.to REST API key (Basic auth). Required by the sync job.
TAWK_API_KEY=your_api_key_here

# Supabase — the central datastore (all reports + escalations read/write here).
# Project URL and the SECRET key (sb_secret_… / service_role). Server-side only;
# never expose the secret key to the browser. If unset, the app falls back to
# live tawk.to reads + a local JSON file store (local dev only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Optional: protect the /api/sync endpoint. If set, callers (Supabase/Vercel cron)
# must send "Authorization: Bearer <CRON_SECRET>". Leave unset to keep it open
# (then protect the whole app at the platform level — it has no built-in auth).
# CRON_SECRET=some-long-random-string
